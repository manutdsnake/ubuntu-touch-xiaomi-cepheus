# UBports recovery fstab for cepheus.  /cache is the recovery's "fake cache"
# (a bind of /data/cache, see setup-fake-cache), so it is not listed.
# system and vendor are logical partitions of the retrofit super (metadata in
# the physical system partition, see init.recovery.qcom.rc); the rootfs goes
# into system.
# <src>                         <mnt>       <type> <mnt_flags>                               <fs_mgr_flags>
/dev/block/by-name/userdata     /data       ext4   noatime,nosuid,nodev,noauto_da_alloc      wait,check,formattable
system                          /system     ext4   ro                                        wait,logical
vendor                          /vendor     ext4   ro                                        wait,logical
/dev/block/by-name/misc         /misc       emmc   defaults                                  defaults
/dev/block/by-name/boot         /boot       emmc   defaults                                  defaults
/dev/block/by-name/recovery     /recovery   emmc   defaults                                  defaults
/dev/block/by-name/dtbo         /dtbo       emmc   defaults                                  defaults
