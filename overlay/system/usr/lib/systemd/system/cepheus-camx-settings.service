[Unit]
Description=Quiet CamX logging (the vendor file logs ~200 error lines per second of preview)
Documentation=file:///etc/cepheus/camxoverridesettings.txt
# The vendor's camxoverridesettings.txt with overrideLogLevels=0x0 and
# systemLogEnable=FALSE, nothing else changed.  With error logging on, the
# camera HAL formats and sends ~10 harmless E/CamX lines per preview frame to
# logd, which costs CPU in both while the camera app runs.
DefaultDependencies=no
After=mount-android-partitions.service halium-android-partitions.service
Before=lxc-android-config.service
ConditionPathExists=/var/lib/lxc/android/rootfs/vendor/etc/camera/camxoverridesettings.txt
ConditionPathExists=/etc/cepheus/camxoverridesettings.txt

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mount --bind /etc/cepheus/camxoverridesettings.txt /var/lib/lxc/android/rootfs/vendor/etc/camera/camxoverridesettings.txt
ExecStop=-/bin/umount /var/lib/lxc/android/rootfs/vendor/etc/camera/camxoverridesettings.txt

[Install]
WantedBy=sysinit.target
