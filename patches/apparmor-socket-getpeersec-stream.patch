+/*
+ * cepheus: SO_PEERSEC for AF_UNIX stream sockets.
+ *
+ * Mainline AppArmor grew socket_getpeersec_stream in 4.17, as part of its
+ * socket mediation.  This 4.14 tree has none, so getsockopt(SO_PEERSEC)
+ * returns -ENOPROTOOPT, dbus-daemon then omits LinuxSecurityLabel from
+ * GetConnectionCredentials, and Ubuntu Touch's media-hub - which fails closed
+ * on an empty label - throws "apparmor::Context cannot be created for empty
+ * name" and dies on every media session.
+ *
+ * 4.17 reads the peer label from the peer socket's own security blob, which
+ * 4.14 AppArmor does not allocate.  For AF_UNIX the same information is
+ * already on sk_peer_cred - the credential SO_PEERCRED reports, captured at
+ * connect/accept - and a cred carries its task's AppArmor label.  Format it
+ * the way 4.17 does, so "unconfined" and "profile (enforce)" come out exactly
+ * as userspace expects.
+ */
+static int apparmor_socket_getpeersec_stream(struct socket *sock,
+					     char __user *optval,
+					     int __user *optlen,
+					     unsigned int len)
+{
+	struct aa_label *label, *peer;
+	const struct cred *peer_cred;
+	char *name = NULL;
+	int slen, error = 0;
+
+	if (!sock->sk || sock->sk->sk_family != AF_UNIX)
+		return -ENOPROTOOPT;
+	peer_cred = sock->sk->sk_peer_cred;
+	if (!peer_cred)
+		return -ENOPROTOOPT;
+
+	label = begin_current_label_crit_section();
+	peer = aa_cred_raw_label(peer_cred);
+	slen = aa_label_asxprint(&name, labels_ns(label), peer,
+				 FLAG_SHOW_MODE | FLAG_VIEW_SUBNS |
+				 FLAG_HIDDEN_UNCONFINED, GFP_KERNEL);
+	if (slen < 0) {
+		error = -ENOMEM;
+		goto done;
+	}
+	if (slen > len) {
+		error = -ERANGE;
+		goto done_len;
+	}
+	if (copy_to_user(optval, name, slen)) {
+		error = -EFAULT;
+		goto out;
+	}
+done_len:
+	if (put_user(slen, optlen))
+		error = -EFAULT;
+out:
+	kfree(name);
+done:
+	end_current_label_crit_section(label);
+	return error;
+}
