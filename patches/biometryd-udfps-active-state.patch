+namespace
+{
+// Publish whether the HAL is currently waiting for a finger, for under-display
+// sensors: something outside biometryd has to light the sensor area and arm the
+// touch controller's FOD detection only while an operation is running.
+// "1" / "0" in /run/biometryd/udfps-active; watch it with inotify.
+void set_udfps_active(bool active)
+{
+    ::mkdir("/run/biometryd", 0755);
+    if (FILE* f = std::fopen("/run/biometryd/udfps-active.tmp", "w"))
+    {
+        std::fputs(active ? "1\n" : "0\n", f);
+        std::fclose(f);
+        std::rename("/run/biometryd/udfps-active.tmp", "/run/biometryd/udfps-active");
+    }
+}
+}
